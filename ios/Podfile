# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  pod 'GoogleUtilities', :modular_headers => true
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
  # Keep CocoaPods modules enabled, but turn off Xcode's module verifier.
  # Xcode 26 re-enables it during project upgrade unless LastUpgradeCheck
  # is kept current, which breaks several generated CocoaPods frameworks.
  module_verifier_flags = ['$(inherited)', '-F$(PODS_CONFIGURATION_BUILD_DIR)']
  installer.pods_project.targets.each do |dependency_target|
    module_verifier_flags << "-F$(PODS_CONFIGURATION_BUILD_DIR)/#{dependency_target.name}"
  end
  module_verifier_flags += [
    '-F$(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates/GoogleMaps/Base',
    '-F$(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates/GoogleMaps/Maps',
    '-F$(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates/ScreenProtectorKit',
    '-F$(PODS_ROOT)/GoogleMaps/Base/Frameworks',
    '-F$(PODS_ROOT)/GoogleMaps/Maps/Frameworks',
    '-F$(PODS_ROOT)/ScreenProtectorKit/Frameworks'
  ]
  module_verifier_flags.uniq!

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings.delete 'IPHONEOS_DEPLOYMENT_TARGET'
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
      config.build_settings['OTHER_MODULE_VERIFIER_FLAGS'] = module_verifier_flags
    end
  end

  installer.pods_project.build_configurations.each do |config|
    config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
    config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
    config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
  end

  # CocoaPods 1.16 writes LastUpgradeCheck = 1600. Xcode 26 then upgrades
  # Pods.xcodeproj during flutter run and flips ENABLE_MODULE_VERIFIER back
  # to YES for framework targets. Mark the generated Pods project as already
  # upgraded for the local Xcode version so the verifier stays disabled.
  installer.pods_project.root_object.attributes['LastUpgradeCheck'] = '2630'

  # ── GTMSessionFetcher: flat modulemap (the ONLY real fix needed) ────
  # Remove `module * { export * }` to prevent implicit submodules.
  # Keep umbrella + export so Swift can still `import GTMSessionFetcher`.
  gtm_mm = "#{installer.sandbox.root}/Target Support Files/GTMSessionFetcher/GTMSessionFetcher.modulemap"
  if File.exist?(gtm_mm)
    File.write(gtm_mm, "framework module GTMSessionFetcher {\n  umbrella header \"GTMSessionFetcher-umbrella.h\"\n  export *\n}\n")
  end

  # Fix Xcode 16 double-quoted includes in CocoaPods generated umbrella headers
  installer.pods_project.targets.each do |target|
    umbrella_header = "#{installer.sandbox.root}/Target Support Files/#{target.name}/#{target.name}-umbrella.h"
    if File.exist?(umbrella_header)
      content = File.read(umbrella_header)
      # ONLY fix specific targets that are known to fail on Xcode 16.
      # Other targets like Firebase precompiled binaries break if we mess with their umbrella headers.
      targets_to_fix = {
        'Mantle' => 'Mantle',
        'PromisesObjC' => 'FBLPromises',
        'Google-Maps-iOS-Utils' => 'GoogleMapsUtils',
        'SDWebImage' => 'SDWebImage',
        'SDWebImageWebPCoder' => 'SDWebImageWebPCoder',
        'GTMSessionFetcher' => 'GTMSessionFetcher',
        'DKImagePickerController' => 'DKImagePickerController',
        'DKPhotoGallery' => 'DKPhotoGallery',
        'SwiftyGif' => 'SwiftyGif',
        'GTMAppAuth' => 'GTMAppAuth',
        'AppAuth' => 'AppAuth',
        'GoogleUtilities' => 'GoogleUtilities',
        'wakelock_plus' => 'wakelock_plus',
        'FirebaseCore' => 'FirebaseCore',
        'FirebaseCoreInternal' => 'FirebaseCoreInternal'
      }

      if targets_to_fix.key?(target.name)
        module_name = targets_to_fix[target.name]
        new_content = content.gsub(/#import\s+"(.*?)"/, "#import <#{module_name}/\\1>")
        File.write(umbrella_header, new_content)
      end
    end
  end

  # Fix PromisesObjC internal headers for Xcode 16 strictness
  promises_dir = "#{installer.sandbox.root}/PromisesObjC/Sources/FBLPromises/include"
  if Dir.exist?(promises_dir)
    Dir.glob("#{promises_dir}/*.h").each do |file|
      content = File.read(file)
      new_content = content.gsub(/#import\s+"(FBLPromise.*?\.h)"/, "#import <FBLPromises/\\1>")
      File.chmod(0644, file) # Ensure we have write permissions
      File.write(file, new_content)
    end
  end

  # Fix SDWebImage public headers for Xcode strict framework include checks.
  sdwebimage_core_dir = "#{installer.sandbox.root}/SDWebImage/SDWebImage/Core"
  if Dir.exist?(sdwebimage_core_dir)
    Dir.glob("#{sdwebimage_core_dir}/*.h").each do |file|
      content = File.read(file)
      new_content = content.gsub(/#import\s+"([^"\/]+\.h)"/, '#import <SDWebImage/\1>')
      if new_content != content
        File.chmod(0644, file)
        File.write(file, new_content)
      end
    end
  end

  # Fix GTMSessionFetcher public headers for Xcode strict framework include checks.
  gtm_public_dir = "#{installer.sandbox.root}/GTMSessionFetcher/Sources/Core/Public/GTMSessionFetcher"
  if Dir.exist?(gtm_public_dir)
    Dir.glob("#{gtm_public_dir}/*.h").each do |file|
      content = File.read(file)
      new_content = content.gsub(
        /#import\s+"(GTMSessionFetcher\/[^"]+\.h)"/,
        '#import <\1>'
      )
      if new_content != content
        File.chmod(0644, file)
        File.write(file, new_content)
      end
    end
  end

  # Fix AppAuth internal headers
  app_auth_dir = "#{installer.sandbox.root}/AppAuth/Sources"
  if Dir.exist?(app_auth_dir)
    Dir.glob("#{app_auth_dir}/**/*.h").each do |file|
      content = File.read(file)
      if content.match?(/#import\s+"OID.*?\.h"/)
        new_content = content.gsub(/#import\s+"(OID.*?\.h)"/, "#import <AppAuth/\\1>")
        File.chmod(0644, file)
        File.write(file, new_content)
      end
    end
  end

  # Fix GoogleUtilities internal headers
  gul_dir = "#{installer.sandbox.root}/GoogleUtilities"
  if Dir.exist?(gul_dir)
    Dir.glob("#{gul_dir}/**/*.h").each do |file|
      content = File.read(file)
      if content.match?(/#import\s+"GUL.*?\.h"/)
        new_content = content.gsub(/#import\s+"(GUL.*?\.h)"/, "#import <GoogleUtilities/\\1>")
        File.chmod(0644, file)
        File.write(file, new_content)
      end
    end
  end



end

target 'ImageNotification' do
  use_frameworks! :linkage => :static
  pod 'GoogleUtilities'
end
